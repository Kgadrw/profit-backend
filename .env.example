# MongoDB

DB_USERNAME=

DB_PASSWORD=

DB_CLUSTER=

DB_NAME=profit-pilot

DNS_SERVERS=8.8.8.8,8.8.4.4

PORT=3000



# SMTP (optional)

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASSWORD=



# Monthly subscription (RWF)

SUBSCRIPTION_AMOUNT=5000

# Simulate payments while Paypack credentials are not set up (dev/testing only)

SUBSCRIPTION_MOCK_PAYMENTS=true

SUBSCRIPTION_MOCK_DELAY_MS=4000



# Paypack (https://payments.paypack.rw)

# Create an application on the Paypack dashboard to get client_id and client_secret

PAYPACK_CLIENT_ID=

PAYPACK_CLIENT_SECRET=

PAYPACK_BASE_URL=https://payments.paypack.rw/api

# development | production — must match your Paypack webhook mode

PAYPACK_WEBHOOK_MODE=production

# Webhook signing secret from Paypack dashboard (for /api/subscription/webhook/paypack)

PAYPACK_WEBHOOK_SIGN_KEY=

